rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminEmail() {
      return signedIn() && request.auth.token.email in ['73404246a@gmail.com', 'axtumnally@g.skku.edu'];
    }
    function memberPath() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function role() {
      return adminEmail() ? 'admin'
        : (signedIn() && exists(memberPath()) ? get(memberPath()).data.role : 'none');
    }
    function canRead() { return role() in ['admin', 'editor', 'viewer']; }
    function canWrite() { return role() in ['admin', 'editor']; }
    function isAdmin() { return role() == 'admin'; }

    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // 처음 로그인: 본인 문서를 승인 대기로만 만들 수 있음 (관리자 이메일은 admin)
      allow create: if signedIn() && request.auth.uid == uid
        && (request.resource.data.role == 'pending' || (request.resource.data.role == 'admin' && adminEmail()));
      // 본인은 닉네임·당번표 이름만 수정, 역할은 관리자만
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
    match /colony/{doc} {
      allow read: if canRead();
      allow write: if canWrite();
    }
    match /events/{id} {
      allow read: if canRead();
      allow create: if canWrite();
      allow update, delete: if isAdmin();
    }
    match /handovers/{id} {
      allow read: if canRead();
      allow create, update: if canWrite();
      allow delete: if isAdmin();
    }
  }
}
